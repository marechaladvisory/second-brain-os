{
  "permissions": {
    "allow": [
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"$CLAUDE_PROJECT_DIR/brain\" \"$CLAUDE_PROJECT_DIR/brain/.claude/hooks/protect.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PROJECT_DIR=\"$CLAUDE_PROJECT_DIR/brain\" \"$CLAUDE_PROJECT_DIR/brain/.claude/hooks/guard-connectors.sh\""
          }
        ]
      }
    ]
  }
}
